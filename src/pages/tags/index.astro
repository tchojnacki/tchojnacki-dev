---
import { countBy } from "lodash-es"

import TagLink from "~/components/blog/list/TagLink.astro"
import { getPosts, getTags } from "~/content"
import Listing from "~/layouts/Listing.astro"

const tags = await getTags()
const counts = countBy((await getPosts()).flatMap(p => p.data.tags))
---

<Listing name="Tags" description="List of all tags from Tomasz Chojnacki's blog.">
  <ul>
    {
      tags.map(tag => (
        <li>
          <TagLink {tag} count={counts[tag]!} />
        </li>
      ))
    }
  </ul>
</Listing>
