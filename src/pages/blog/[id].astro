---
import { render } from "astro:content"

import "katex/dist/katex.min.css"

import Banner from "~/components/blog/Banner.astro"
import PostFooter from "~/components/blog/PostFooter.astro"
import PostHeader from "~/components/blog/PostHeader.astro"
import { typography } from "~/components/blog/typography"
import Link from "~/components/common/Link"
import { lookingForJob } from "~/consts/hiring"
import { linkedin, resume } from "~/consts/socials"
import { getPosts, pathsFrom, type Post } from "~/content"
import Layout from "~/layouts/Layout.astro"

export const getStaticPaths = pathsFrom(getPosts, post => ({
  params: { id: post.id },
  props: { post },
}))

interface Props {
  post: Post
}

const { post } = Astro.props
const {
  Content,
  remarkPluginFrontmatter: { readingTime },
} = await render(post)
---

<Layout name={post.data.title} description={post.data.abstract}>
  <main class="min-h-screen">
    <article>
      <PostHeader {post} {readingTime} />
      <section class="post-content">
        <Content components={{ ...typography }} />
        <div class:list={["mt-8 text-justify", lookingForJob ? null : "opacity-50"]}>
          <Banner kind="info">
            {
              // prettier-ignore
              lookingForJob ? (
                <>
                  I am currently seeking employment in <strong>front-end</strong> or
                  <strong>full-stack</strong> engineer roles (junior/mid-level), ideally in a
                  <strong>remote</strong> setting within EMEA or in a hybrid setup near Wrocław,
                  Poland. If you enjoyed this post or think my skills could be a good fit, I would
                  love for you to <strong><Link href={resume.href}>check out my resume</Link></strong>
                  or <strong><Link href={linkedin.href}>connect with me on LinkedIn</Link></strong>.
                </>
              )
                : "The views expressed in this post are my own and do not reflect those of my employer."
            }
          </Banner>
        </div>
      </section>
      <PostFooter id={post.id} />
    </article>
  </main>
</Layout>

<style>
  .post-content {
    display: grid;
    grid-template-columns: 1fr min(var(--spacing-reading), calc(100% - 3rem)) 1fr;
    grid-column-gap: 1rem;
  }

  .post-content > :global(*) {
    grid-column: 2;
  }

  .post-content > :global(astro-island) {
    display: block;
  }

  .post-content > :global(.post-full-bleed) {
    width: 100%;
    grid-column: 1 / -1;
  }

  .post-content > :global(.expressive-code) {
    margin: 0.5rem 0;
  }
</style>
