---
import { IconArrowRight } from "@tabler/icons-react"
import { render } from "astro:content"

import type { Post } from "~/content"

interface Props {
  heading: number
  post: Post
}

const { heading, post } = Astro.props
const {
  remarkPluginFrontmatter: { readingTime },
} = await render(post)

const H = `h${heading}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6"

const tags = [...post.data.skills.map(s => s.id), ...post.data.tags].toSorted()
---

<article itemscope itemtype="https://schema.org/BlogPosting">
  <a
    itemprop="url"
    class="group hover:**:text-neutral-1000! dark:hover:**:text-neutral-0! flex max-w-xl flex-col gap-2 p-6 **:duration-200"
    href={`/blog/${post.id}`}
  >
    <H
      itemprop="name headline"
      class="text-xl font-bold text-purple-700 group-hover:underline dark:text-purple-300"
    >
      {post.data.title}
    </H>
    <div class="flex flex-col gap-2 text-sm sm:flex-row sm:justify-between">
      <span
        ><time
          itemprop="dateCreated dateModified datePublished"
          datetime={post.data.date.toISOString()}
          >{
            post.data.date.toLocaleDateString("en-US", {
              weekday: undefined,
              day: "numeric",
              month: "short",
              year: "numeric",
            })
          }</time
        > &bull; <span itemprop="timeRequired">{readingTime} min read</span></span
      >
      <ul itemprop="keywords" class="flex gap-2 text-purple-700 dark:text-purple-300">
        {tags.map(t => <li>#{t}</li>)}
      </ul>
    </div>
    <p
      itemprop="abstract description"
      class="text-sm text-neutral-700 sm:text-justify sm:hyphens-auto dark:text-neutral-300"
    >
      {post.data.abstract}
    </p>
    <div
      class="text-neutral-1000 dark:text-neutral-0 flex items-center gap-1 text-sm leading-none font-bold"
    >
      Read more <IconArrowRight
        role="presentation"
        className="stroke-neutral-1000 dark:stroke-neutral-0 inline-block opacity-0 group-hover:opacity-100"
        size="16"
      />
    </div>
  </a>
</article>
