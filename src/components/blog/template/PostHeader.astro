---
import { sortBy } from "es-toolkit"

import Link from "~/components/common/Link"
import type { Post } from "~/content"

import Bullet from "./Bullet.astro"

interface Props {
  post: Post
  readingTime: number
}

const { post, readingTime } = Astro.props

const tags = sortBy(
  [
    ...post.data.skills.map(s => ({ tag: s.id, href: `/skills/${s.id}` })),
    ...post.data.tags.map(t => ({ tag: t, href: `/tags/${t}` })),
  ],
  ["tag"],
)
---

<header class="centered-header flex flex-col gap-3 text-center sm:text-left">
  <h1 itemprop="name headline" class="text-3xl text-neutral-1000 sm:text-4xl dark:text-neutral-0">
    {post.data.title}
  </h1>
  <div class="text-neutral-800 dark:text-neutral-200">
    <span
      itemprop="author accountablePerson copyrightHolder editor"
      itemscope
      itemtype="https://schema.org/Person"
    >
      by&nbsp;
      <address
        itemprop="name"
        class="inline-block font-bold text-neutral-1000 not-italic dark:text-neutral-0"
      >
        {post.data.author}
      </address>
    </span>
    <Bullet />
    on&nbsp;
    <time
      itemprop="dateCreated dateModified datePublished"
      datetime={post.data.date.toISOString()}
      class="font-bold text-neutral-1000 dark:text-neutral-0"
    >
      {post.data.date.toLocaleDateString("en-US", {
        weekday: undefined,
        day: "numeric",
        month: "long",
        year: "numeric",
      })}
    </time>
    <Bullet />
    <span itemprop="timeRequired" class="font-bold text-neutral-1000 dark:text-neutral-0">
      {readingTime}&nbsp;min
    </span>
    &nbsp;read
  </div>
  <ul itemprop="keywords" class="flex flex-wrap justify-center gap-4 sm:justify-start">
    {tags.map(({ tag, href }) => (
      <li>
        <Link {href}>#{tag}</Link>
      </li>
    ))}
  </ul>
</header>
