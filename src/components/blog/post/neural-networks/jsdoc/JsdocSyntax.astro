---
import JsdocCond from "./JsdocCond"

if (!Astro.slots.has("typed") || !Astro.slots.has("untyped")) {
  throw new Error("JsdocSyntax requires both 'typed' and 'untyped' slots to be provided.")
}
---

<JsdocCond when={true} client:idle>
  <slot name="typed" />
</JsdocCond>
<JsdocCond when={false} client:idle>
  <slot name="untyped" />
</JsdocCond>
