---
import { getProjects, type Project } from "~/content"

import ProjectCard from "./ProjectCard.astro"

interface Props {
  heading: number
  filter?: (project: Project) => boolean
}

const { heading, filter } = Astro.props

const projects = (await getProjects()).filter(p => !filter || filter(p))
---

<ul class="flex flex-col items-center gap-8 px-2 py-8 sm:gap-16 lg:px-16">
  {projects.map((project, i) => <ProjectCard {heading} {project} flipped={i % 2 === 1} />)}
</ul>
