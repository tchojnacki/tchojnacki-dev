---
import SectionHeader from "~/components/common/SectionHeader.astro"
import Wave from "~/components/common/Wave.astro"
import { getPosts, getProjects } from "~/content"

const metrics = [
  {
    value: new Date().getFullYear() - 2016,
    label: ["years", "coding"],
  },
  {
    value: (await getProjects()).length,
    label: ["finished", "projects"],
  },
  {
    value: (await getPosts()).length,
    label: ["posts", "written"],
  },
] as const

const s = "font-bold text-neutral-1000 dark:text-neutral-0"
const p = "my-2"
---

<main class="bg-indigo-100 px-6 dark:bg-indigo-900">
  <SectionHeader text="About me" />
  <div class="flex flex-col items-center text-neutral-600 dark:text-neutral-400">
    {
      /* prettier-ignore */
      (<div class="max-w-reading py-4 brightness-75 sm:text-justify sm:hyphens-auto dark:brightness-125">
        <p class={p}>
          I&nbsp;am a&nbsp;mid <strong class={s}>full-stack</strong> software engineer specializing in
          <strong class={s}>React and NestJS</strong>, with strong foundations in databases, DevOps, AI, Python, and Rust.
          Currently, I&nbsp;work on EPM and CPaaS solutions for a&nbsp;telecommunications company, supporting 2&#8239;000+
          networks and over 100&#8239;000+ VoIP customer lines. My role combines scalable system design with real-world
          reliability requirements in high-availability environments.
        </p>
        <p class={p}>
          Previously, I&nbsp;<strong class={s}>interned at Atlassian</strong>, where I&nbsp;delivered production features to Jira,
          contributing to a&nbsp;product used by 300&#8239;000+ teams worldwide. As a&nbsp;<strong class={s}>freelance developer</strong>,
          I&nbsp;partnered directly with clients to design, build, and deploy high-performing websites attracting 2&#8239;000+
          monthly users, translating business needs into practical technical solutions.
        </p>
        <p class={p}>
          I&nbsp;hold both a&nbsp;Bachelor's and <strong class={s}>Master's degree in Applied Computer Science</strong>
          from the Wrocław University of Science and Technology, graduating top of my class. I&nbsp;also
          <strong class={s}>published scientific</strong> research in Information and Software Technology, a&nbsp;top
          10% journal according to CORE rankings.
        </p>
      </div>)
    }
    <ul class="grid grid-cols-3 gap-8 py-4 sm:gap-12">
      {
        metrics.map(({ value, label }) => (
          <li class="text-center">
            <div class="text-2xl font-bold text-indigo-700 dark:text-indigo-300">{value}</div>
            <div class="text-sm text-neutral-900 dark:text-neutral-100">
              {label[0]}
              <br />
              {label[1]}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</main>
<Wave inverted />
