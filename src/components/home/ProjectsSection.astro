---
import CtaButton from "~/components/common/CtaButton"
import SectionHeader from "~/components/common/SectionHeader.astro"
import ProjectList from "~/components/projects/ProjectList.astro"
import { featuredProjects } from "~/consts/featured"
import type { Project } from "~/content"

const filter = (project: Project) => featuredProjects.includes(project.id)
---

<section>
  <SectionHeader text="Featured projects" />
  <ProjectList heading={3} {filter} />
  <div class="mb-4 flex justify-center">
    <CtaButton label="View all projects" action="/projects" />
  </div>
</section>
