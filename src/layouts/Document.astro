---
import Analytics from "@vercel/analytics/astro"
import SpeedInsights from "@vercel/speed-insights/astro"
import { SEO } from "astro-seo"
import { Font } from "astro:assets"
import { createHash } from "node:crypto"

import { canonize } from "~/lib/format"

import "~/global.css"

const DEFAULT_TITLE = "Tomasz Chojnacki"
const DEFAULT_DESCRIPTION =
  "Personal website of Tomasz Chojnacki, a graduate software engineer based in Wrocław."

interface Props {
  name?: string
  description?: string
}

const { name, description = DEFAULT_DESCRIPTION } = Astro.props
const title = name === undefined ? DEFAULT_TITLE : `${name} - ${DEFAULT_TITLE}`
const image = new URL("/static/open-graph.png", Astro.site).href
const canonical = canonize(Astro.url.href)

const themeScript = `
  const theme = (() => {
    const local = localStorage.getItem("theme")
    if (local === "dark" || local === "light") return local
    return "dark"
  })()

  if (theme === "dark") {
    document.documentElement.classList.add("dark")
    document.documentElement.dataset["theme"] = "github-dark"
  } else {
    document.documentElement.classList.remove("dark")
    document.documentElement.dataset["theme"] = "github-light"
  }
`
Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(themeScript).digest("base64")}`)
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <SEO
      {title}
      {description}
      {canonical}
      openGraph={{
        basic: {
          title,
          type: "website",
          image,
          url: canonical,
        },
        optional: {
          description,
          siteName: DEFAULT_TITLE,
          locale: "en_US",
        },
        image: {
          url: image,
          width: 1280,
          height: 720,
          alt: "Image of the website.",
        },
      }}
      twitter={{ card: "summary" }}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f9ff" />
    <link rel="icon" href="/static/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternative" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <Font cssVariable="--font-inter" preload />
    <script is:inline set:html={themeScript} />
  </head>
  <body class="overflow-x-hidden bg-neudigo-50 text-neutral-900 dark:bg-neudigo-950 dark:text-neutral-100">
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
