---
import { cn } from "~/lib/cn"

import styles from "./ErrorPage.module.css"
import Layout from "./Layout.astro"

interface Props {
  code: number
}

const { code } = Astro.props
---

<Layout name={code.toString()}>
  <main class="mt-[calc(-1*var(--spacing-nav-height))] grid min-h-screen place-items-center p-6">
    <header class="text-center">
      <h1
        class={cn(
          "mb-4 text-6xl font-bold text-indigo-700 dark:text-indigo-300",
          styles.animateErrorShake,
        )}
      >
        {code}
      </h1>
      <h2 class="text-3xl"><slot /></h2>
    </header>
  </main>
</Layout>
