{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*", ".storybook/**/*"],
  "exclude": ["dist", "coverage", "storybook-static"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./src/*"],
      "@post/*": ["./src/components/blog/post/*"]
    },
    "noPropertyAccessFromIndexSignature": true,
    "erasableSyntaxOnly": true
  }
}
