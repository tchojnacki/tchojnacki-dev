{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "arrowParens": "avoid",
  "sortTailwindcss": { "stylesheet": "./src/global.css" },
  "astro": {},
  "sortImports": {
    "customGroups": [
      { "groupName": "styles", "selector": "side_effect_style" },
      { "groupName": "alias", "elementNamePattern": ["~/**"] }
    ],
    "groups": [["builtin", "external"], "alias", ["parent", "sibling", "index"], "styles"],
    "newlinesBetween": true
  },
  "ignorePatterns": ["*.mdx"]
}
